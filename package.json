{
  "name": "@comfyorg/sdk",
  "version": "0.1.0",
  "private": false,
  "description": "TypeScript SDK for running ComfyUI workflows via the Comfy API v2 (self-hosted, Comfy Cloud, serverless).",
  "keywords": [
    "comfy",
    "comfyui",
    "diffusion",
    "generative-ai",
    "sdk",
    "workflow"
  ],
  "homepage": "https://github.com/Comfy-Org/comfy-typescript-sdk#readme",
  "bugs": {
    "url": "https://github.com/Comfy-Org/comfy-typescript-sdk/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Comfy-Org/comfy-typescript-sdk.git"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./low": {
      "types": "./dist/low/index.d.ts",
      "default": "./dist/low/index.js"
    },
    "./errors": {
      "types": "./dist/sdk/routerErrors.d.ts",
      "default": "./dist/sdk/routerErrors.js"
    }
  },
  "scripts": {
    "build": "node scripts/gen-version.mjs && tsc",
    "generate": "openapi-ts",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:spec-drift": "node scripts/check-spec-drift.mjs",
    "check:sdk-parity": "node scripts/sync-python-surface.mjs",
    "sync:python-surface": "node scripts/sync-python-surface.mjs --write"
  },
  "dependencies": {
    "eventsource-parser": "^3.0.0",
    "hash-wasm": "^4.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.62.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.13.0"
}
